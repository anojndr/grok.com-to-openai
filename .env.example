# Copy to .env and fill in. NEVER commit real keys.

# freeimage.host API key for hosting generated images (https://freeimage.host/page/api)
FREEIMAGE_API_KEY=

# Optional: protect this server (clients then send Authorization: Bearer <key>)
G2O_API_KEY=

# Port (default 45080)
G2O_PORT=45080

# Path to grok cookie accounts file
G2O_ACCOUNTS_FILE=accounts.txt
# SQLite database path for persistent sessions, accounts and caches
G2O_DB_PATH=data/grok_store.db

# Cooldown after failures (seconds)
G2O_COOLDOWN=300

# Multi-turn session TTL (seconds)
G2O_SESSION_TTL=3600
# Optional: include sources bridge for llmcord-go's "Show Sources" button (0 or 1)
G2O_INCLUDE_SOURCES=0
